# 編輯器共用設定：程式與繁體中文註解統一使用 UTF-8、兩格縮排。
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 以 BOM 辨識繁體中文腳本；其他原始碼仍用 UTF-8。
[*.ps1]
charset = utf-8-bom
